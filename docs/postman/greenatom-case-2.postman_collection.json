							"script": {
								"type": "text/javascript",
								"exec": [
									"// Исчерпываем лимит: rateLimitMax запросов, основной запрос должен получить 429",
									"const max = Number(pm.variables.get('rateLimitMax') || 100);",
									"for (let i = 0; i < max; i++) {",
									"  pm.sendRequest(pm.variables.replaceIn('{{baseUrl}}/health'), () => {});",
									"}"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('429 Too Many Requests'.trim(), () => pm.response.to.have.status(429));",
									"const json = pm.response.json();",
									"pm.test('code TOO_MANY_REQUESTS', () => pm.expect(json.error.code).to.eql('TOO_MANY_REQUESTS'));",
									"pm.test('Retry-After header', () => pm.expect(pm.response.headers.get('Retry-After')).to.be.a('string'));",
									"pm.test('RateLimit header', () => pm.expect(pm.response.headers.get('RateLimit')).to.be.a('string'));"
								]
							}
						}
					]
				}
			],
