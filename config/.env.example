## Environment: development | production | test
NODE_ENV=development

## Server
PORT=3000
BODY_LIMIT=100kb

## CORS: список источников через запятую, "*" запрещён
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

## Rate limit на /api ##
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

## Внешний погодный API (Open-Meteo, модуль Кейса 1)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000
WEATHER_FORECAST_DAYS=3
WEATHER_TEMPERATURE_UNIT=celsius
WEATHER_PRECIPITATION_UNIT=mm

## Аутентификация изменяющих запросов (X-API-Key). Пусто = выключено
API_KEY=*type some API-KEY*

# База данных (PostgreSQL v18)
## В docker compose для сервиса api DB_HOST переопределяется на "postgres"
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=*type some db user*
DB_PASSWORD=*type some db password*
DB_NAME=*type some db name*
## Пул соединений Sequelize (необязательно, указаны значения по умолчанию)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000
