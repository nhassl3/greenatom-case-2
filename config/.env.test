## Environment 
NODE_ENV=test


## Server 
PORT=4000
HOST=localhost

## Setup jet-logger
JET_LOGGER_MODE=console
JET_LOGGER_FILEPATH=jet-logger.log
JET_LOGGER_TIMESTAMP=true
JET_LOGGER_FORMAT=line

BODY_LIMIT=100kb
## CORS: список источников через запятую, "*" запрещён 
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
## Rate limit на /api ##
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10000
## Внешний погодный API (Open-Meteo, модуль Кейса 1) 
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000
WEATHER_FORECAST_DAYS=3
WEATHER_TEMPERATURE_UNIT=celsius
WEATHER_PRECIPITATION_UNIT=mm
## Аутентификация изменяющих запросов (X-API-Key). Пусто = выключено 
API_KEY=